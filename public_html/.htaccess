<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Pass Authorization and API-Key headers to backend
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{HTTP:X-API-KEY} .
  RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X-API-KEY}]

  # API proxy to Laravel
  RewriteCond %{REQUEST_URI} ^/laravel/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^laravel/(.*)$ /laravel/public/index.php [L,QSA]
  
  # Allow direct access to legacy API
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # SPA Fallback for React
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

Options -Indexes

# ── GZIP Compression (hemat 60-80% bandwidth di mobile) ──────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ── Browser Caching: vendor chunks jarang berubah, cache 1 tahun ─────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — no cache (SPA butuh versi terbaru)
  ExpiresByType text/html                 "access plus 0 seconds"

  # JS/CSS assets — cache 1 tahun (Vite pakai hash di filename)
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  ExpiresByType image/png                "access plus 1 month"
  ExpiresByType image/jpeg               "access plus 1 month"
  ExpiresByType image/webp               "access plus 1 month"
</IfModule>

# ── Cache-Control headers ─────────────────────────────────────────────────────
<FilesMatch "\.(js|css|woff2|woff|svg)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
