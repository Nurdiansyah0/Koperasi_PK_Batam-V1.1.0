APP_NAME="Koperasi PK Batam"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://koperasipkbatam.my.id/laravel

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dqfqxjrd_koperasi
DB_USERNAME=dqfqxjrd_kopuser
DB_PASSWORD=GANTI_DENGAN_PASSWORD_HOSTING

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480

# Sanctum — token-based (no cookie/SPA needed since frontend uses Bearer tokens)
SANCTUM_STATEFUL_DOMAINS=koperasipkbatam.my.id

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@koperasipkbatam.my.id"
MAIL_FROM_NAME="Koperasi PK Batam"
